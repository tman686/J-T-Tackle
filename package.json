{
  "name": "jt-tackle",
  "version": "0.1.0",
  "private": true,
  "description": "J & T Tackle — the operating system for a soft-plastic fishing lure company. Phase 1 foundation.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @jt/website",
